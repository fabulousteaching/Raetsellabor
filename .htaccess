# Rätsellabor: Der Browser soll Seite, Skripte und Stile bei jedem Laden beim Server nachfragen
# («no-cache» = vor jeder Verwendung prüfen; unveränderte Dateien kommen als kurze 304-Antwort zurück).
# So ist nach dem Neuladen immer die neueste Version da. Bilder und Schriften dürfen einen Tag im Cache bleiben.
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|js|css|php|json|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
</IfModule>
